#
# This script creates the policy based routing rules. It expects the routing tables to be already registered and named with a common prefix.
#
# Usage:
#   vpn_policy_reconfigure [-4|-6] prefix offset [id...]
# where
#   prefix is the routing table prefix (e.g. wireguard)
#   offset each rule is given a priority of offset + id
#

if [ $# -ge '3' ];
then
    # Policy Routing Rules:
    # add policy routing rules
    IP_VERSION=$1
    TABLE_NAME_PREFIX=$2
    OFFSET=$3

    # clear all previously set rules
    #
    # Rules can become numeric when their rt_tables entry was removed before this
    # cleanup runs. For example, "lookup wireguard1" is then rendered by iproute2
    # as "lookup 101". Match both forms, but only for rules generated by this
    # script: pref == OFFSET + fwmark and lookup is either PREFIX<mark> or the
    # corresponding numeric table id.
    while read -r PREF MARK_HEX LOOKUP_TABLE; do
        ROUTE_ID=$((16#$MARK_HEX))
        TABLE_ID=$(($OFFSET + $ROUTE_ID))
        if [ "$PREF" -eq "$TABLE_ID" ] && \
            { [ "$LOOKUP_TABLE" = "$TABLE_NAME_PREFIX$ROUTE_ID" ] || [ "$LOOKUP_TABLE" = "$TABLE_ID" ]; }; then
            ip $IP_VERSION rule del pref "$PREF"
        fi
    done < <(ip $IP_VERSION rule | sed -nE 's/^([0-9]+):.*fwmark 0x([[:xdigit:]]+).*lookup ([^ ]+).*/\1 \2 \3/p')

    shift 3
    while(("$#")); do
        ip $IP_VERSION rule add prio $(($OFFSET+$1)) from all fwmark $1 table $TABLE_NAME_PREFIX$1
        shift
    done

    # cleanup,commit changes
    ip $IP_VERSION route flush cache
else
    echo "Wrong number of arguments!" 1>&2
    exit 1
fi
