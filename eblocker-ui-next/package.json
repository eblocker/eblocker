{
  "name": "@eblocker/ui-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Modern eBlocker UI shell built with React, TypeScript and Vite.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "generate:openapi": "node scripts/generate-openapi-assets.mjs",
    "prebuild": "npm run generate:openapi",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "pretest": "npm run generate:openapi",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "vite": "8.1.2"
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "swagger-ui-dist": "5.32.8",
    "vitest": "4.1.9"
  },
  "scarfSettings": {
    "enabled": false
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10.0.0"
  }
}
